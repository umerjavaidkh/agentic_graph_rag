# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.env

# Terraform secrets (real API keys / passwords live here)
*.tfvars
*.tfvars.json
.terraform/
*.tfstate
*.tfstate.*

# Output and generated data
data/assets/
data/feedback/
data/blobs/
# Uploaded files staged mid-ingest; two were committed by accident.
tmp_ingest/
output/
output_v2/
output_v3/

# OS files
.DS_Store

# Editor directories
# .vscode/ is committed on purpose: shared interpreter, pytest and debug config
# so the repo works on a fresh clone. Personal overrides go in *.local.json.
.vscode/*.local.json
.idea/

# Eval UI runner recordings (large videos)
eval/ui_runs/

# Playwright browsers (local, used by scripts/run_rag_eval_ui.py)
.venv/
.pw-browsers/

# graphify (local code-graph tool, generated/regenerable via `graphify update .`)
.claude/
CLAUDE.md
graphify-out/

# Sample/test documents — real source PDFs are not pushed to GitHub.
# Exception: rag_document.pdf is committed deliberately because six unit
# tests parse it as a fixture (golden structural snapshot, IR parsing,
# rtldoc/table-aware parser behaviour, search_text derivation), so the suite
# cannot run on a fresh clone without it. It is small (868K) and
# redistributable; the larger corpora below are not.
sample_data_to_test/unstructured/*.pdf
# ...and in any subdirectory of it. The single-level rule above matched
# nothing under sample_data_to_test/unstructured/arabic/, so a 54.6 MB
# Arabic corpus was committed by a change that believed it was ignored.
# Test corpora are downloaded, not redistributed -- see the note above.
sample_data_to_test/unstructured/**/*.pdf
!sample_data_to_test/unstructured/rag_document.pdf
sample_data_to_test/unstructured/sec_edgar/
sample_data_to_test/unstructured/textbooks/

# Local screenshots/scratch images (README uses docs/images/)
images/

# Session / trace artifacts from local debugging runs. These accumulated in the
# repo root untracked; nothing in the project reads them.
agentic_rag_trace.json
agentic_rag_session.jsonl
agentic_graph_rag_trace.zip
pytest_passed.txt
*.patch
sample_data_to_test/unstructured/corpus10/
sample_data_to_test/unstructured/corpus100/
sample_data_to_test/unstructured/corpus500/
sample_data_to_test/unstructured/corpus500_ingest/
sample_data_to_test/unstructured/corpus1000/
